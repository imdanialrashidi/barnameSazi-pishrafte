---
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getEntriesByKind } from '../../lib/content';
import { courseConfig } from '../../config/course';

const entries = await getEntriesByKind('concept');
---

<ListingLayout
  title="مفاهیم"
  description={`مفاهیم کلیدی ${courseConfig.title} — هرکدام دقیق و با مثال. برای فهم عمیق یا مرور سریع بخوانید.`}
  entries={entries}
/>