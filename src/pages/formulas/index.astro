---
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getEntriesByKind } from '../../lib/content';
import { courseConfig } from '../../config/course';

const entries = await getEntriesByKind('formula');
---

<ListingLayout
  title="فرمول‌ها"
  description={`فرمول‌ها و نمادهای ${courseConfig.title} با معنی هر نماد و شرایط اعتبار. برای حل مسئله مستقیم استفاده کنید.`}
  entries={entries}
/>